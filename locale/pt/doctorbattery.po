#: main.lua:114
msgid ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━\n"
"\n"
"ℹ️ INFORMAZIONI\n"
"\n"
"DoctorBattery analizza lo stato della batteria\n"
"utilizzando i dati esposti dal sistema del Kindle.\n"
"\n"
"Le valutazioni sono stime e non sostituiscono\n"
"gli strumenti diagnostici del produttore.\n"
"\n"
"Sviluppato per KOReader.\n"
"By Lo Shady"
msgstr ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━\n"
"\n"
"ℹ️ INFORMAÇÃO\n"
"\n"
"O DoctorBattery analisa o estado da bateria\n"
"utilizando os dados disponibilizados pelo sistema do Kindle.\n"
"\n"
"As avaliações são estimativas e não substituem\n"
"as ferramentas de diagnóstico do fabricante.\n"
"\n"
"Desenvolvido para o KOReader.\n"
"Por Lo Shady"

