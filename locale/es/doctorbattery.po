#: main.lua:114
msgid ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━━━\n"
"\n"
"ℹ️ INFORMAZIONI\n"
"\n"
"DoctorBattery analizza lo stato della batteria\n"
"utilizzando i dati esposti dal sistema del Kindle.\n"
"\n"
"Le valutazioni sono stime e non sostituiscono\n"
"gli strumenti diagnostici del produttore.\n"
"\n"
"Sviluppato per KOReader.\n"
"By Lo Shady"
msgstr ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━━━\n"
"\n"
"ℹ️ INFORMACIÓN\n"
"\n"
"DoctorBattery analiza el estado de la batería\n"
"utilizando los datos proporcionados por el sistema Kindle.\n"
"\n"
"Las evaluaciones son estimaciones y no sustituyen\n"
"las herramientas de diagnóstico del fabricante.\n"
"\n"
"Desarrollado para KOReader.\n"
"Por Lo Shady"

