#: main.lua:26
#, lua-format
msgid ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━━━\n"
"\n"
"📋 STATO BATTERIA\n"
"\n"
"🔋 Carica: %d%%\n"
"❤️ Salute: %s\n"
"⚡ Stato: %s\n"
"🔄 Cicli di ricarica: %d"
msgstr ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━━━\n"
"\n"
"📋 AKKUSTATUS\n"
"\n"
"🔋 Ladung: %d%%\n"
"❤️ Akkuzustand: %s\n"
"⚡ Status: %s\n"
"🔄 Ladezyklen: %d"

#: main.lua:50
msgid ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━━━\n"
"\n"
"🩺 DIAGNOSI\n"
"\n"
msgstr ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━━━\n"
"\n"
"🩺 DIAGNOSE\n"
"\n"

#: main.lua:64
#, lua-format
msgid ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━━━\n"
"\n"
"⚙️ PARAMETRI ELETTRICI\n"
"\n"
"🌡️ Temperatura: %d °C\n"
"🔌 Tensione attuale: %.3f V\n"
"⬆️ Tensione massima: %.3f V\n"
"⬇️ Tensione minima: %.3f V\n"
"\n"
"⚡ Corrente attuale: %.1f mA\n"
"📊 Corrente media: %.1f mA\n"
"⬆️ Corrente massima: %.0f mA\n"
"\n"
"🔋 Capacità attuale: %.0f mAh\n"
"📈 Capacità reale: %.0f mAh\n"
"🏭 Capacità progetto: %.0f mAh\n"
"📦 Gauge stimato: %.0f mAh\n"
"\n"
"📉 Usura: %.1f%%\n"
"🛡️ Parametri sicuri: %s\n"
"⚠️ Stress: %s"
msgstr ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━━━\n"
"\n"
"⚙️ ELEKTRISCHE PARAMETER\n"
"\n"
"🌡️ Temperatur: %d °C\n"
"🔌 Aktuelle Spannung: %.3f V\n"
"⬆️ Maximale Spannung: %.3f V\n"
"⬇️ Minimale Spannung: %.3f V\n"
"\n"
"⚡ Aktueller Strom: %.1f mA\n"
"📊 Durchschnittsstrom: %.1f mA\n"
"⬆️ Maximaler Strom: %.0f mA\n"
"\n"
"🔋 Aktuelle Kapazität: %.0f mAh\n"
"📈 Tatsächliche Kapazität: %.0f mAh\n"
"🏭 Nennkapazität: %.0f mAh\n"
"📦 Geschätzter Ladezustand: %.0f mAh\n"
"\n"
"📉 Verschleiß: %.1f%%\n"
"🛡️ Sicheres Laden: %s\n"
"⚠️ Belastung: %s"

#: main.lua:102
msgid "Attiva"
msgstr "Aktiv"

#: main.lua:102
msgid "Non attiva"
msgstr "Nicht aktiv"

#: main.lua:103
msgid "Presente"
msgstr "Vorhanden"

#: main.lua:103
msgid "Assente"
msgstr "Nicht vorhanden"

#: main.lua:114
msgid ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━━━\n"
"\n"
"ℹ️ INFORMAZIONI\n"
"\n"
"DoctorBattery analizza lo stato della batteria\n"
"utilizzando i dati esposti dal sistema del Kindle.\n"
"\n"
"Le valutazioni sono stime e non sostituiscono\n"
"gli strumenti diagnostici del produttore.\n"
"\n"
"Sviluppato per KOReader.\n"
"By Lo Shady"
msgstr ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━━━\n"
"\n"
"ℹ️ INFORMATIONEN\n"
"\n"
"DoctorBattery analysiert den Zustand des Akkus\n"
"mithilfe der vom Kindle-System bereitgestellten Daten.\n"
"\n"
"Die Bewertungen sind Schätzungen und ersetzen nicht\n"
"die Diagnosetools des Herstellers.\n"
"\n"
"Entwickelt für KOReader.\n"
"Von Lo Shady"

#: main.lua:157
msgid "🩺 DoctorBattery"
msgstr "🩺 DoctorBattery"

#: main.lua:163
msgid "📋 Riepilogo"
msgstr "📋 Übersicht"

#: main.lua:166
msgid "Riepilogo"
msgstr "Übersicht"

#: main.lua:173
msgid "🩺 Diagnosi"
msgstr "🩺 Diagnose"

#: main.lua:176
msgid "Diagnosi"
msgstr "Diagnose"

#: main.lua:183
msgid "⚙️ Parametri tecnici"
msgstr "⚙️ Technische Parameter"

#: main.lua:186
msgid "Parametri tecnici"
msgstr "Technische Parameter"

#: main.lua:193
msgid "ℹ️ Informazioni"
msgstr "ℹ️ Informationen"

#: main.lua:196
msgid "Informazioni"
msgstr "Informationen"

#: main.lua:203
msgid "❌ Chiudi"
msgstr "❌ Schließen"

#: main.lua:233
#: _meta.lua:5
msgid "DoctorBattery"
msgstr "DoctorBattery"

#: diagnosis.lua:59
#, lua-format
msgid "%s Battery Score: %d/100"
msgstr "%s Akkubewertung: %d/100"

#: diagnosis.lua:76
msgid "🟢 Batteria in condizioni eccellenti"
msgstr "🟢 Akku in ausgezeichnetem Zustand"

#: diagnosis.lua:83
msgid "🟡 Batteria in buone condizioni"
msgstr "🟡 Akku in gutem Zustand"

#: diagnosis.lua:90
msgid "🔴 Batteria usurata"
msgstr "🔴 Akku ist verschlissen"

#: diagnosis.lua:105
#, lua-format
msgid "• Cicli di ricarica: %d"
msgstr "• Ladezyklen: %d"

#: diagnosis.lua:112
msgid "🟢 Batteria ancora giovane"
msgstr "🟢 Akku ist noch relativ neu"

#: diagnosis.lua:119
msgid "🟡 Usura nella norma"
msgstr "🟡 Verschleiß im normalen Bereich"

#: diagnosis.lua:126
msgid "🟠 Cicli elevati"
msgstr "🟠 Hohe Anzahl an Ladezyklen"

#: diagnosis.lua:133
msgid "🔴 Numero di cicli molto elevato"
msgstr "🔴 Sehr hohe Anzahl an Ladezyklen"

#: diagnosis.lua:149
#, lua-format
msgid "• Capacità reale: %.0f / %.0f mAh"
msgstr "• Tatsächliche Kapazität: %.0f / %.0f mAh"

#: diagnosis.lua:162
#, lua-format
msgid "🟢 Capacità eccellente (%.1f%%)"
msgstr "🟢 Ausgezeichnete Kapazität (%.1f%%)"

#: diagnosis.lua:172
#, lua-format
msgid "🟡 Capacità buona (%.1f%%)"
msgstr "🟡 Gute Kapazität (%.1f%%)"

#: diagnosis.lua:182
#, lua-format
msgid "🟠 Capacità ridotta (%.1f%%)"
msgstr "🟠 Verringerte Kapazität (%.1f%%)"

#: diagnosis.lua:192
#, lua-format
msgid "🔴 Capacità molto degradata (%.1f%%)"
msgstr "🔴 Stark verringerte Kapazität (%.1f%%)"

#: diagnosis.lua:213
#, lua-format
msgid "🔴 Temperatura critica: %.1f°C"
msgstr "🔴 Kritische Temperatur: %.1f°C"

#: diagnosis.lua:220
#, lua-format
msgid "🟡 Batteria fredda (%.1f°C)"
msgstr "🟡 Akku ist kalt (%.1f°C)"

#: diagnosis.lua:227
#, lua-format
msgid "🟢 Temperatura ottimale (%.1f°C)"
msgstr "🟢 Optimale Temperatur (%.1f°C)"

#: diagnosis.lua:234
#, lua-format
msgid "🟠 Batteria calda (%.1f°C)"
msgstr "🟠 Akku ist warm (%.1f°C)"

#: diagnosis.lua:241
#, lua-format
msgid "🔴 Batteria molto calda (%.1f°C)"
msgstr "🔴 Akku ist sehr heiß (%.1f°C)"

#: diagnosis.lua:258
msgid "🟢 Ricarica protetta attiva"
msgstr "🟢 Akkuschutz beim Laden aktiv"

#: diagnosis.lua:263
msgid ""
"• Il sistema sta limitando la ricarica per preservare la durata della batteria."
msgstr ""
"• Das System begrenzt den Ladevorgang, um die Lebensdauer des Akkus zu verlängern."

#: diagnosis.lua:270
msgid "🟢 Ricarica normale"
msgstr "🟢 Normales Laden"

#: diagnosis.lua:287
msgid "🔴 La batteria mostra segni di stress"
msgstr "🔴 Der Akku zeigt Anzeichen von Belastung"

#: diagnosis.lua:292
msgid ""
"• Evita scariche complete e temperature elevate per preservarne la durata."
msgstr ""
"• Vermeiden Sie vollständige Entladungen und hohe Temperaturen, um die Lebensdauer des Akkus zu verlängern."

#: diagnosis.lua:299
msgid "🟢 Nessun segno di stress rilevato"
msgstr "🟢 Keine Anzeichen von Belastung festgestellt"

#: diagnosis.lua:317
msgid "In scarica"
msgstr "Wird entladen"

#: diagnosis.lua:318
msgid "In carica"
msgstr "Wird geladen"

#: diagnosis.lua:319
msgid "Carica completa"
msgstr "Vollständig geladen"

#: diagnosis.lua:320
msgid "Sconosciuto"
msgstr "Unbekannt"

#: diagnosis.lua:328
msgid "Ottima"
msgstr "Ausgezeichnet"

#: diagnosis.lua:329
msgid "Esaurita"
msgstr "Leer"

#: diagnosis.lua:330
msgid "Surriscaldata"
msgstr "Überhitzt"

#: diagnosis.lua:331
msgid "Troppo fredda"
msgstr "Zu kalt"

#: diagnosis.lua:332
msgid "Sconosciuta"
msgstr "Unbekannt"

#: _meta.lua:6
msgid "Analyze battery health and charging status"
msgstr "Analysiert den Akkuzustand und den Ladestatus"