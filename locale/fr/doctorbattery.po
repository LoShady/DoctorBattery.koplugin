#: main.lua:114
msgid ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━━━\n"
"\n"
"ℹ️ INFORMAZIONI\n"
"\n"
"DoctorBattery analizza lo stato della batteria\n"
"utilizzando i dati esposti dal sistema del Kindle.\n"
"\n"
"Le valutazioni sono stime e non sostituiscono\n"
"gli strumenti diagnostici del produttore.\n"
"\n"
"Sviluppato per KOReader.\n"
"By Lo Shady"
msgstr ""
"🩺 DoctorBattery\n"
"━━━━━━━━━━━━━━━━━━\n"
"\n"
"ℹ️ INFORMATIONS\n"
"\n"
"DoctorBattery analyse l'état de la batterie\n"
"à partir des données fournies par le système Kindle.\n"
"\n"
"Les évaluations sont des estimations et ne remplacent pas\n"
"les outils de diagnostic du fabricant.\n"
"\n"
"Développé pour KOReader.\n"
"Par Lo Shady"

